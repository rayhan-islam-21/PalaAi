# --- Database (Neon: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL) ---
DATABASE_URL="postgresql://postgres@localhost:5432/pala?schema=public"
DIRECT_URL="postgresql://postgres@localhost:5432/pala?schema=public"

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL of the app (used for auth callbacks and invite links)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Anthropic (server-side only; never expose to the browser) ---
# Leave empty to disable live chat (users see a clear "chat unavailable" message).
ANTHROPIC_API_KEY=""

# --- Development demo mode ---
# "true" enables the clearly-labelled MOCK AI provider, the demo clock and demo seed data.
# Refused automatically when VERCEL_ENV=production. Never enable for real customers.
PALA_DEMO_MODE="false"

# --- Initial admin (used by `npm run admin:create`) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
